NODE_ENV=development
PORT=4090

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=

# Comma-separated origins for CORS (use * only in local dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Secure cookie session lifetime
SESSION_TTL_HOURS=168

# Finding attachments are deleted after this many days
MEDIA_RETENTION_DAYS=30

# Media storage: local | s3
STORAGE_PROVIDER=local
MEDIA_STORAGE_PATH=.data/media

# Required when STORAGE_PROVIDER=s3
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=ship-maintenance-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional key prefix and custom endpoint (MinIO / LocalStack)
# AWS_S3_PREFIX=findings
# AWS_S3_ENDPOINT=http://localhost:9000

# Private Matrix homeserver
MATRIX_INTERNAL_URL=http://localhost:8008
MATRIX_PUBLIC_URL=http://localhost:5173
MATRIX_SERVER_NAME=ship-maintenance.local
MATRIX_ADMIN_USERNAME=shipmaintenance_bridge
MATRIX_ADMIN_PASSWORD=replace-with-at-least-16-random-characters
MATRIX_USER_PASSWORD_SECRET=replace-with-at-least-32-random-characters
MATRIX_REGISTRATION_SHARED_SECRET=replace-with-another-long-random-secret
MATRIX_REGISTRATION_SECRET_FILE=matrix/registration.secret
