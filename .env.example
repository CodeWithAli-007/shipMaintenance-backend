NODE_ENV=production
PORT=4090

# PostgreSQL (system Postgres on the VPS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ship_app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ship_maintenance

# Frontend origin(s), comma-separated
CORS_ORIGIN=https://your-frontend-domain.com

SESSION_TTL_HOURS=168
MEDIA_RETENTION_DAYS=30
STORAGE_PROVIDER=local
MEDIA_STORAGE_PATH=.data/media

# Optional S3
# STORAGE_PROVIDER=s3
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=ship-maintenance-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_PREFIX=findings

# Matrix (optional encrypted chat — install Synapse separately if needed)
MATRIX_INTERNAL_URL=http://localhost:8008
MATRIX_PUBLIC_URL=https://your-frontend-domain.com
MATRIX_SERVER_NAME=ship-maintenance.local
MATRIX_ADMIN_USERNAME=shipmaintenance_bridge
MATRIX_ADMIN_PASSWORD=replace-with-at-least-16-random-characters
MATRIX_USER_PASSWORD_SECRET=replace-with-at-least-32-random-characters
MATRIX_REGISTRATION_SHARED_SECRET=replace-with-another-long-random-secret
MATRIX_REGISTRATION_SECRET_FILE=matrix/registration.secret
